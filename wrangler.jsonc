{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app91",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4a454958-b40e-48ed-8ab1-fba5e5be16cf","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dc8cfdf06c114988b9ee61e50c85fddd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
